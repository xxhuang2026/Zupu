# 留空时自动使用浏览器当前访问地址；填写时不能有结尾斜线。
APP_ORIGIN=
FORCE_HTTPS=false
APP_PORT=39210
APP_BIND_IP=0.0.0.0

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin
INITIAL_ADMIN_NAME=管理员

# 默认使用本机源码构建的 1.0 镜像。
ZUPU_IMAGE=zupu:1.0-local
ZUPU_DATA_DIR=./data
ZUPU_BACKUP_DIR=./backups
ZUPU_MANAGED_BACKUP_DIR=./managed-backups
